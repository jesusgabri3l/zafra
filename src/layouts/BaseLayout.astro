---
import { Font } from 'astro:assets';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.jpg`, Astro.site).href;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ZAFRA',
  url: canonical,
  inLanguage: 'es-CO',
  description,
  disambiguatingDescription: 'Marca ficticia: demo de concepto de landing, no una soda real a la venta.',
});
const bottlePreloads = [
  { media: '(max-width: 767px)', href: `${base}/bottle/m/maracuya.webp` },
  { media: '(min-resolution: 1.5dppx)', href: `${base}/bottle/2x/maracuya.webp` },
  { media: '(max-resolution: 1.49dppx)', href: `${base}/bottle/1x/maracuya.webp` },
];
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5C1236" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZAFRA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo ZAFRA y botella de maracuyá en gouache, demo de concepto." />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {bottlePreloads.map(({ media, href }) => (
      <link rel="preload" as="image" href={href} media={media} />
    ))}
    {import.meta.env.PROD && (
      <script is:inline data-goatcounter="https://zafra.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
    )}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      // is-scrub: la página se recorre con scroll (secciones fijas); data-loading: el loader bloquea el scroll hasta que termina.
      const root = document.documentElement;
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('is-scrub');
      root.setAttribute('data-loading', '');
      // El recorrido siempre arranca en la portada: al recargar a mitad de página el navegador restauraba el scroll y la botella
      // aparecía con la pose de la intro en otra sección. Se fija antes de que cargue nada y se deja el scroll en 0 al salir.
      if (root.classList.contains('is-scrub')) {
        history.scrollRestoration = 'manual';
        addEventListener('pagehide', () => scrollTo(0, 0));
      }
    </script>
    <Font cssVariable="--font-hand" />
    <style set:html={`:root{--img-papel:url(${base}/img/papel.webp);--img-papel-sombra:url(${base}/img/papel-sombra.webp);--img-brochazo:url(${base}/img/brochazo.webp)}`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
