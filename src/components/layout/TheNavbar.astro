---
import BaseButton from '../base/BaseButton.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="navbar" data-navbar data-tone="dark">
  <a class="navbar__brand" href="#contenido" aria-label="ZAFRA, inicio">
    <img class="navbar__logo navbar__logo--light" src={`${base}/img/logo-gouache.webp`} width="640" height="214" alt="" />
    <img class="navbar__logo navbar__logo--dark" src={`${base}/img/logo-gouache-maracuya.webp`} width="640" height="214" alt="" />
  </a>
  <BaseButton class="navbar__cta" href="#pedido" size="small" data-jump>Pedir</BaseButton>
</header>
