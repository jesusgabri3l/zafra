---
import BaseTear from '../base/BaseTear.astro';
import { FLAVORS } from '../../data/flavors';
import { CREDIT_LINKS, SITE } from '../../config/site';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const icons: Record<string, string> = {
  GitHub: 'M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z',
  LinkedIn: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.5 0h3.83v1.57h.05c.53-1 1.84-2.07 3.78-2.07 4.04 0 4.79 2.66 4.79 6.12v5.88h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4V9.75Z',
};

const columns = [
  { title: 'Sabores', links: FLAVORS.map(({ name }) => ({ label: name, href: '#sabores-titulo' })) },
  { title: 'Pedido', links: [{ label: 'Arma tu six-pack', href: '#pedido' }, { label: 'WhatsApp', href: `https://wa.me/${SITE.whatsapp}`, external: true }] },
  { title: 'Créditos', links: CREDIT_LINKS.map(({ label, href, event }) => ({ label, href, event, external: true })) },
] as const;
---

<footer class="footer" data-bar="footer" data-footer data-analytics-section="footer">
  <BaseTear />
  <div class="footer__landscape" aria-hidden="true">
    <img src={`${base}/img/footer-paisaje-full.webp`} alt="" width="1774" height="798" loading="lazy" decoding="async" />
  </div>

  <div class="footer__top">
    <div class="footer__brand">
      <img class="footer__logo" src={`${base}/img/logo-gouache-maracuya.webp`} alt="ZAFRA" width="640" height="214" loading="lazy" decoding="async" />
      <p class="footer__about">Soda de panela con fruta de verdad: pulpa entera, panela y burbujas. Marca ficticia — demo de concepto.</p>
      <ul class="footer__social" aria-label="Redes de Jesús Gabriel">
        {CREDIT_LINKS.map(({ label, href, event }) => (
          <li>
            <a class="footer__icon" href={href} target="_blank" rel="noopener" data-goatcounter-click={event} aria-label={`${label} (abre en una pestaña nueva)`}>
              {label in icons ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={icons[label]} /></svg>
              ) : (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" /><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" /></svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="footer__columns" aria-label="Mapa del sitio">
      {columns.map(({ title, links }) => (
        <div class="footer__column">
          <h3 class="footer__heading">{title}</h3>
          <ul class="footer__list">
            {links.map((link) => (
              <li>
                <a
                  class="footer__link"
                  href={link.href}
                  {...('external' in link ? { target: '_blank', rel: 'noopener' } : {})}
                  {...('event' in link ? { 'data-goatcounter-click': link.event } : {})}
                >{link.label}{'external' in link && <span class="sr-only"> (abre en una pestaña nueva)</span>}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <p class="footer__legal">
    <span>Diseño y desarrollo: Jesús Gabriel</span>
    <span>ZAFRA © {year}</span>
  </p>
</footer>
